# --- Redis (esta PC como servidor: suele ser localhost; en la otra PC apunta aquí) ---
REDIS_URL=redis://localhost:6379
# Si Redis tiene contraseña:
# REDIS_URL=redis://:TU_PASSWORD@127.0.0.1:6379

# Misma clave en todos los procesos Node que compartan sesión / clúster
SESSION_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio

# Orígenes del navegador permitidos (separados por coma, sin espacios extra si puedes).
# Incluye SIEMPRE localhost y la IP LAN de ESTA máquina para cuando abras el chat desde la otra PC:
# CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.15:5173
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Puerto del backend Node en esta instancia
PORT=3051
